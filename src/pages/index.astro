---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects, fileNumberFor, toModalPayload } from '../data/projects';

const scriptSrc = `${import.meta.env.BASE_URL}script.js`;

const navItems = [
  { href: '#home', label: '01 / Subject' },
  { href: '#projects', label: '02 / Operations' },
  { href: '#about', label: '03 / Background' },
  { href: '#contact', label: '04 / Contact' },
];

const totalFiles = fileNumberFor(projects.length - 1);

// Handed to public/script.js, which cannot import from src/. Escaping `<` keeps
// a stray "</script>" inside the copy from terminating the tag early.
const modalPayload = JSON.stringify(toModalPayload()).replace(/</g, '\\u003c');

const contactEmail = 'jmq.caballero@gmail.com';

const manifest = [
  'Flutter',
  'Unity AR',
  'ARCore/ARKit',
  'Node.js',
  'Laravel',
  '3D Modeling',
  'Hostinger',
  'Tailwind CSS',
];

const closedFiles = String(
  projects.filter((project) => project.status === 'Completed').length
).padStart(2, '0');

const dossierRecord = [
  { label: 'Designation', value: 'Full Stack Developer' },
  { label: 'Specialization', value: 'Web Applications / Augmented Reality' },
  { label: 'Years Active', value: '01' },
  { label: 'Files On Record', value: totalFiles },
  { label: 'Files Closed', value: closedFiles },
];
---

<BaseLayout>
  <!-- Skip Links for Accessibility -->
  <a
    href="#main-content"
    class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 bg-ink text-paper px-4 py-2 z-[10000] font-mono text-xs uppercase tracking-widest"
    >Skip to main content</a
  >

  <!-- Preloader -->
  <div
    id="preloader"
    class="fixed top-0 left-0 w-full h-full bg-paper z-[9999] flex flex-col items-center justify-center gap-4 transition-opacity duration-300"
  >
    <div class="stamp stamp--lg">Classified</div>
    <div class="file-meta file-meta--ink">Decrypting file<span class="animate-pulse">...</span></div>
    <div class="w-40 h-1 bg-rule overflow-hidden">
      <div class="decrypt-bar h-full w-1/3 bg-stamp"></div>
    </div>
  </div>

  <!-- Navbar: file header bar -->
  <nav
    class="fixed top-0 left-0 w-full z-50 bg-paper/95 backdrop-blur-md border-t-2 border-stamp border-b border-ink transition-all duration-300 px-4 sm:px-6 lg:px-8 py-2.5 sm:py-3"
    id="navbar"
    role="navigation"
    aria-label="Main navigation"
  >
    <div class="max-w-6xl mx-auto flex justify-between items-center gap-4">
      <a href="#home" class="flex flex-col leading-tight" aria-label="Mervin Caballero - Home">
        <span class="file-meta file-meta--stamp">Case File No. 2025-JMC-001</span>
        <span class="font-stencil text-base sm:text-lg uppercase tracking-wider text-ink"
          >Caballero, M.</span
        >
      </a>

      <div class="hidden md:flex items-center gap-6 lg:gap-8">
        {
          navItems.map((item) => (
            <a
              href={item.href}
              class="nav-item file-meta hover:text-stamp transition-colors uppercase"
            >
              {item.label}
            </a>
          ))
        }
        <button
          type="button"
          id="declassify-toggle"
          class="declassify-toggle"
          aria-pressed="false"
          data-label-on="Reclassify All"
          data-label-off="Declassify All"
        >
          Declassify All
        </button>
      </div>

      <button class="md:hidden cursor-pointer p-2 -mr-2" id="burger" aria-label="Toggle mobile menu" aria-expanded="false">
        <div class="w-5 h-0.5 bg-ink my-1 transition-all duration-300"></div>
        <div class="w-5 h-0.5 bg-ink my-1 transition-all duration-300"></div>
        <div class="w-5 h-0.5 bg-ink my-1 transition-all duration-300"></div>
      </button>
    </div>
  </nav>

  <!-- Mobile Menu -->
  <div
    class="fixed top-[57px] sm:top-[65px] right-0 h-0 w-full md:hidden bg-paper border-b-2 border-ink overflow-hidden transition-all duration-300 z-40"
    id="mobile-menu"
    role="menu"
    aria-hidden="true"
  >
    <div class="flex flex-col items-start gap-1 py-4 px-6">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class="nav-item file-meta text-sm py-3 w-full border-b border-rule hover:text-stamp transition-colors"
            onclick="closeMobileMenu()"
            role="menuitem"
          >
            {item.label}
          </a>
        ))
      }
      <button
        type="button"
        id="declassify-toggle-mobile"
        class="declassify-toggle mt-4"
        aria-pressed="false"
        data-label-on="Reclassify All"
        data-label-off="Declassify All"
      >
        Declassify All
      </button>
    </div>
  </div>

  <main id="main-content">
    <!-- SECTION 01: Subject profile -->
    <section id="home" class="hero min-h-screen flex items-center pt-20 sm:pt-24" role="banner">
      <div class="container max-w-6xl mx-auto px-4 sm:px-6 py-12 sm:py-16">
        <div class="grid grid-cols-1 lg:grid-cols-5 gap-8 lg:gap-12 items-center">
          <div class="lg:col-span-3 space-y-6 text-left">
            <div class="flex flex-wrap items-center gap-3 opacity-0 animate-fade-in">
              <span class="chip-ink">Section 01</span>
              <span class="file-meta">Subject Profile</span>
            </div>

            <h1
              class="font-stencil text-4xl sm:text-5xl md:text-6xl lg:text-7xl uppercase leading-[0.95] text-ink opacity-0 animate-slide-in-left"
            >
              Mervin<br />Caballero
            </h1>

            <hr class="rule-double max-w-sm opacity-0 animate-fade-in" style="animation-delay: 0.2s" />

            <p
              class="text-accent text-base max-w-xl leading-relaxed opacity-0 animate-slide-in-left"
              style="animation-delay: 0.3s"
            >
              Creating immersive digital experiences with 1 year of experience in
              <button type="button" class="redact" aria-expanded="false" aria-label="Redacted text, activate to reveal"
                >web applications</button
              >
              and
              <button type="button" class="redact" aria-expanded="false" aria-label="Redacted text, activate to reveal"
                >AR solutions</button
              >.
            </p>

            <!-- Record table -->
            <dl
              class="max-w-xl border-t border-ink opacity-0 animate-fade-in"
              style="animation-delay: 0.4s"
            >
              {
                dossierRecord.map((row) => (
                  <div class="flex gap-4 border-b border-rule py-2">
                    <dt class="file-meta w-40 flex-shrink-0">{row.label}</dt>
                    <dd class="file-meta file-meta--ink">{row.value}</dd>
                  </div>
                ))
              }
              <div class="flex gap-4 border-b border-rule py-2">
                <dt class="file-meta w-40 flex-shrink-0">Last Known Location</dt>
                <dd class="file-meta file-meta--ink">
                  <button
                    type="button"
                    class="redact"
                    aria-expanded="false"
                    aria-label="Redacted text, activate to reveal">Tanauan, Batangas</button
                  >
                </dd>
              </div>
            </dl>

            <div
              class="flex flex-wrap gap-3 opacity-0 animate-slide-in-left"
              style="animation-delay: 0.5s"
            >
              <a href="#projects" class="btn-dossier">Open Case Files &rarr;</a>
              <a href="#contact" class="btn-dossier btn-dossier--ghost">Request Contact</a>
            </div>
          </div>

          <!-- Subject photograph -->
          <div
            class="lg:col-span-2 flex justify-center lg:justify-end opacity-0 animate-slide-in-right order-first lg:order-last"
            style="animation-delay: 0.2s"
          >
            <figure class="relative w-full max-w-xs sm:max-w-sm">
              <div class="doc-sheet corner-marks p-3">
                <div class="evidence overflow-hidden border border-ink aspect-square">
                  <img
                    src="Assets/ME.jpg"
                    alt="Mervin Caballero - Full Stack Developer"
                    class="w-full h-full object-cover"
                    loading="lazy"
                  />
                </div>
                <figcaption class="file-meta mt-2 flex justify-between">
                  <span>Exhibit A</span>
                  <span class="file-meta--stamp">ID Verified</span>
                </figcaption>
              </div>
              <span class="stamp stamp-overlay">Declassified</span>
            </figure>
          </div>
        </div>

        <!-- Technology manifest -->
        <div
          class="mt-16 lg:mt-20 opacity-0 animate-fade-in"
          style="animation-delay: 0.6s"
        >
          <div class="flex items-center gap-3 mb-4">
            <span class="chip-ink">Annex A</span>
            <span class="file-meta">Technology Manifest</span>
            <hr class="flex-grow rule-stamp" />
          </div>
          <div class="flex flex-wrap gap-2">
            {manifest.map((tech) => <span class="tag-code">{tech}</span>)}
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 02: Field operations -->
    <section id="projects" class="band-tint py-16 sm:py-20 lg:py-24 border-t border-ink">
      <div class="container max-w-6xl mx-auto px-4 sm:px-6">
        <div class="mb-10 sm:mb-14">
          <div class="flex flex-wrap items-center gap-3 mb-4">
            <span class="chip-ink">Section 02</span>
            <span class="file-meta">Field Operations</span>
            <hr class="flex-grow rule-stamp" />
          </div>
          <h2 class="font-stencil text-3xl sm:text-4xl md:text-5xl uppercase text-ink">
            Work Experience
          </h2>
          <p class="file-meta mt-2">
            {totalFiles} Files On Record &middot; Clearance Granted
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
          {
            projects.map((project, index) => (
              <ProjectCard
                project={project}
                fileNumber={fileNumberFor(index)}
                totalFiles={totalFiles}
              />
            ))
          }
        </div>
      </div>
    </section>

    <!-- SECTION 03: Subject background -->
    <section id="about" class="py-16 sm:py-20 lg:py-24 border-t border-ink">
      <div class="container max-w-6xl mx-auto px-4 sm:px-6">
        <div class="grid grid-cols-1 lg:grid-cols-5 gap-8 lg:gap-12">
          <div class="lg:col-span-2">
            <div class="flex flex-wrap items-center gap-3 mb-4 opacity-0 animate-fade-in">
              <span class="chip-ink">Section 03</span>
              <span class="file-meta">Subject Background</span>
            </div>
            <h2
              class="font-stencil text-3xl md:text-4xl uppercase mb-6 text-ink opacity-0 animate-slide-up"
              style="animation-delay: 0.1s"
            >
              Professional Journey
            </h2>

            <p
              class="text-accent text-base mb-8 leading-relaxed opacity-0 animate-fade-in"
              style="animation-delay: 0.2s"
            >
              With 1 year of experience in full-stack development and emerging technologies, I
              specialize in creating immersive digital experiences that bridge the physical and
              digital worlds. From traditional web applications to cutting-edge AR solutions, I
              focus on delivering innovative technology that enhances user engagement.
            </p>

            <div class="space-y-3 mb-8">
              <div
                class="flex items-start gap-4 border-l-2 border-ink pl-4 py-1 opacity-0 animate-slide-in-left"
                style="animation-delay: 0.3s"
              >
                <span class="chip-ink mt-0.5">EDU</span>
                <div>
                  <h3 class="font-stencil uppercase text-ink tracking-wide">
                    Batangas State University
                  </h3>
                  <p class="file-meta">Information Technology &middot; 2025</p>
                </div>
              </div>
              <div
                class="flex items-start gap-4 border-l-2 border-ink pl-4 py-1 opacity-0 animate-slide-in-left"
                style="animation-delay: 0.4s"
              >
                <span class="chip-ink mt-0.5">OPS</span>
                <div>
                  <h3 class="font-stencil uppercase text-ink tracking-wide">1 Year Experience</h3>
                  <p class="file-meta">Full-stack development</p>
                </div>
              </div>
              <div
                class="flex items-start gap-4 border-l-2 border-ink pl-4 py-1 opacity-0 animate-slide-in-left"
                style="animation-delay: 0.5s"
              >
                <span class="chip-ink mt-0.5">LOG</span>
                <div>
                  <h3 class="font-stencil uppercase text-ink tracking-wide">6 Projects</h3>
                  <p class="file-meta">Delivered successfully</p>
                </div>
              </div>
            </div>

            <a
              href="Assets/Resume.pdf"
              target="_blank"
              rel="noopener noreferrer"
              class="btn-dossier"
            >
              Download Full Dossier (PDF) &rarr;
            </a>
          </div>

          <div class="lg:col-span-3">
            <div class="doc-sheet corner-marks p-5 sm:p-7">
              <div class="flex items-center gap-3 mb-6">
                <span class="chip-stamp">Annex B</span>
                <span class="file-meta">Capability Assessment</span>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 sm:gap-8 mb-8">
                <div class="opacity-0 animate-slide-up" style="animation-delay: 0.4s">
                  <h4 class="font-stencil uppercase text-ink mb-3 pb-2 border-b border-ink">
                    Mobile &amp; AR Development
                  </h4>
                  <ul class="space-y-1.5">
                    <li class="file-meta file-meta--ink">&#9642; Flutter &amp; Dart</li>
                    <li class="file-meta file-meta--ink">&#9642; Unity AR Development</li>
                    <li class="file-meta file-meta--ink">&#9642; ARCore &amp; ARKit</li>
                    <li class="file-meta file-meta--ink">&#9642; AR Flutter Plugin</li>
                    <li class="file-meta file-meta--ink">&#9642; 3D Modeling &amp; Blender</li>
                  </ul>
                </div>
                <div class="opacity-0 animate-slide-up" style="animation-delay: 0.5s">
                  <h4 class="font-stencil uppercase text-ink mb-3 pb-2 border-b border-ink">
                    Web Development
                  </h4>
                  <ul class="space-y-1.5">
                    <li class="file-meta file-meta--ink">&#9642; PHP &amp; Laravel</li>
                    <li class="file-meta file-meta--ink">&#9642; Node.js &amp; JavaScript</li>
                    <li class="file-meta file-meta--ink">&#9642; WordPress &amp; WooCommerce</li>
                    <li class="file-meta file-meta--ink">&#9642; Laravel Livewire</li>
                    <li class="file-meta file-meta--ink">&#9642; Tailwind CSS</li>
                  </ul>
                </div>
              </div>

              <div class="mb-8">
                <h4 class="font-stencil uppercase text-ink mb-3 pb-2 border-b border-ink">
                  Operational Experience
                </h4>
                <div class="grid sm:grid-cols-2 gap-x-6 gap-y-1.5">
                  <p class="file-meta file-meta--ink">&#9642; AR Museum Applications</p>
                  <p class="file-meta file-meta--ink">&#9642; Custom CMS Development</p>
                  <p class="file-meta file-meta--ink">&#9642; E-commerce Platforms</p>
                  <p class="file-meta file-meta--ink">&#9642; HR Management Systems</p>
                  <p class="file-meta file-meta--ink">&#9642; Flutter Mobile Apps</p>
                  <p class="file-meta file-meta--ink">&#9642; Full-Stack Web Solutions</p>
                </div>
              </div>

              <div>
                <h4 class="font-stencil uppercase text-ink mb-3 pb-2 border-b border-ink">
                  Database &amp; Tools
                </h4>
                <div class="flex flex-wrap gap-1.5">
                  <span class="tag-code">MySQL</span>
                  <span class="tag-code">Hostinger</span>
                  <span class="tag-code">GitHub</span>
                  <span class="tag-code">Git Version Control</span>
                  <span class="tag-code">Python</span>
                  <span class="tag-code">HTML/CSS</span>
                  <span class="tag-code">Responsive Design</span>
                  <span class="tag-code">REST APIs</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 04: Establish contact -->
    <section id="contact" class="band-tint py-16 sm:py-20 lg:py-24 border-t border-ink">
      <div class="container max-w-6xl mx-auto px-4 sm:px-6">
        <div class="flex flex-wrap items-center gap-3 mb-4">
          <span class="chip-ink">Section 04</span>
          <span class="file-meta">Establish Contact</span>
          <hr class="flex-grow rule-stamp" />
        </div>
        <h2
          class="font-stencil text-3xl sm:text-4xl md:text-5xl uppercase mb-10 text-ink opacity-0 animate-slide-up"
        >
          Contact
        </h2>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12">
          <div class="space-y-5">
            <div class="opacity-0 animate-slide-in-left" style="animation-delay: 0.1s">
              <p class="file-meta mb-1">Secure Channel</p>
              <p class="text-ink">
                <button
                  type="button"
                  class="redact"
                  aria-expanded="false"
                  aria-label="Redacted email address, activate to reveal"
                  >jmq.caballero@gmail.com</button
                >
              </p>
              <a href="mailto:jmq.caballero@gmail.com" class="file-meta file-meta--stamp hover:underline"
                >Transmit Directly &rarr;</a
              >
            </div>
            <div class="opacity-0 animate-slide-in-left" style="animation-delay: 0.2s">
              <p class="file-meta mb-1">Operating Area</p>
              <p class="text-ink">
                <button
                  type="button"
                  class="redact"
                  aria-expanded="false"
                  aria-label="Redacted location, activate to reveal">Tanauan, Batangas</button
                >
              </p>
            </div>
            <div class="opacity-0 animate-slide-in-left" style="animation-delay: 0.3s">
              <p class="file-meta mb-2">Known Associates</p>
              <div class="flex flex-wrap gap-2">
                <a href="https://github.com/JMrvnC" target="_blank" rel="noopener noreferrer" class="tag-code"
                  >GitHub</a
                >
                <a
                  href="https://www.linkedin.com/in/john-mervin-caballero-105230314"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="tag-code">LinkedIn</a
                >
                <a
                  href="https://www.facebook.com/MachipoiWTF"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="tag-code">Facebook</a
                >
              </div>
            </div>
          </div>

          <div class="opacity-0 animate-slide-in-right" style="animation-delay: 0.2s">
            <div class="doc-sheet corner-marks p-5 sm:p-7">
              <div class="flex items-center gap-3 mb-6">
                <span class="chip-stamp">Form 04-B</span>
                <span class="file-meta">Transmission Request</span>
              </div>
              <form id="contactForm" class="space-y-5" data-contact-email={contactEmail}>
                <div>
                  <label for="name" class="file-meta block mb-1">Field 01 &mdash; Name</label>
                  <input
                    type="text"
                    id="name"
                    name="name"
                    autocomplete="name"
                    class="field-dossier"
                    placeholder="Enter name"
                  />
                </div>
                <div>
                  <label for="email" class="file-meta block mb-1">Field 02 &mdash; Return Address</label>
                  <input
                    type="email"
                    id="email"
                    name="email"
                    autocomplete="email"
                    class="field-dossier"
                    placeholder="your.email@example.com"
                  />
                </div>
                <div>
                  <label for="message" class="file-meta block mb-1">Field 03 &mdash; Message Body</label>
                  <textarea
                    id="message"
                    name="message"
                    rows="5"
                    maxlength="1400"
                    class="field-dossier"
                    placeholder="Enter message"></textarea>
                </div>

                {/* Spam trap. Real people never fill this in; bots usually do. */}
                <input
                  type="checkbox"
                  name="botcheck"
                  class="hidden"
                  style="display:none"
                  tabindex="-1"
                  autocomplete="off"
                />

                <button type="submit" class="btn-dossier">Transmit &rarr;</button>

                <p
                  id="formStatus"
                  class="file-meta hidden border-l-2 border-stamp pl-3 py-1"
                  role="status"
                  aria-live="polite"
                >
                </p>
              </form>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <!-- Footer -->
  <footer class="border-t-2 border-ink py-6 sm:py-8">
    <div class="container max-w-6xl mx-auto px-4 sm:px-6">
      <hr class="rule-stamp mb-4" />
      <div class="flex flex-col md:flex-row justify-between items-center gap-3 sm:pr-16">
        <p class="file-meta">End of File &middot; &copy; 2025 Mervin Caballero</p>
        <div class="flex gap-4">
          <a href="https://github.com/JMrvnC" target="_blank" rel="noopener noreferrer" class="file-meta hover:text-stamp transition-colors">GitHub</a>
          <a
            href="https://www.linkedin.com/in/mervin-caballero-105230314/"
            target="_blank"
            rel="noopener noreferrer"
            class="file-meta hover:text-stamp transition-colors">LinkedIn</a
          >
          <a
            href="https://www.facebook.com/MachipoiWTF"
            target="_blank"
            rel="noopener noreferrer"
            class="file-meta hover:text-stamp transition-colors">Facebook</a
          >
        </div>
        <p class="file-meta">Page 01 of 01</p>
      </div>
    </div>
  </footer>

  <!-- Scroll to top -->
  <button
    id="scroll-to-top"
    class="fixed bottom-4 right-4 sm:bottom-8 sm:right-8 bg-ink text-paper opacity-0 invisible transition-all duration-200 hover:bg-stamp focus:outline-none z-50 w-11 h-11 sm:w-12 sm:h-12 flex items-center justify-center border border-ink"
    aria-label="Scroll to top"
  >
    <span class="font-mono text-lg">&uarr;</span>
  </button>

  <!-- Project Details Modal, presented as a case folder being opened -->
  <div
    id="projectModal"
    class="fixed inset-0 z-[9999] hidden items-center justify-center p-2 sm:p-4 overflow-y-auto"
    role="dialog"
    aria-modal="true"
    aria-labelledby="modalTitle"
  >
    <div class="dossier-folder" id="dossierFolder">
      <!-- Folder cover. Rotates away on open, drops back on close. -->
      <div class="folder-flap" aria-hidden="true">
        <div class="folder-flap-inner">
          <span class="folder-flap-tab">Confidential</span>
          <span class="folder-flap-title">Case Folder</span>
          <span class="folder-flap-note">Unauthorized disclosure is punishable by law</span>
        </div>
      </div>

      <!-- Terminal beat that plays while the folder opens -->
      <div class="folder-boot" aria-hidden="true">
        <p class="folder-boot-line">&gt; Accessing file</p>
        <div class="folder-boot-bar"><span class="decrypt-bar"></span></div>
        <p class="folder-boot-line">&gt; Authorizing clearance</p>
      </div>

      <div class="folder-sheet">
        <div
          class="px-4 sm:px-6 py-3 border-b-2 border-ink flex justify-between items-center gap-4 sticky top-0 bg-paper-raw z-10"
        >
          <div class="min-w-0">
            <p class="file-meta file-meta--stamp">Case File &middot; Declassified</p>
            <h2
              id="modalTitle"
              class="font-stencil text-lg sm:text-2xl uppercase text-ink leading-tight"
            >
            </h2>
          </div>
          <button
            type="button"
            data-close-project
            class="file-meta file-meta--ink flex-shrink-0 border border-ink w-10 h-10 flex items-center justify-center hover:bg-stamp hover:text-white hover:border-stamp transition-colors"
            aria-label="Close file"
          >
            <i class="fas fa-times"></i>
          </button>
        </div>
        <div class="p-4 sm:p-6">
          <div id="modalContent" class="grid grid-cols-1 lg:grid-cols-2 gap-6 sm:gap-8">
            <!-- Content will be dynamically loaded here -->
          </div>
        </div>
      </div>

      <span class="stamp folder-stamp" aria-hidden="true">Declassified</span>
    </div>
  </div>

  <!-- Image Modal -->
  <div
    id="imageModal"
    class="fixed inset-0 z-[10000] hidden items-center justify-center p-2 sm:p-4"
  >
    <div class="relative w-full h-full flex flex-col items-center justify-center">
      <button
        type="button"
        data-close-image
        class="absolute top-2 right-2 sm:top-4 sm:right-4 z-10 bg-paper-raw text-ink border border-ink w-11 h-11 flex items-center justify-center hover:bg-stamp hover:text-white hover:border-stamp transition-colors"
        aria-label="Close image"
      >
        <i class="fas fa-times"></i>
      </button>
      <img
        id="modalImage"
        class="max-w-full max-h-[80vh] sm:max-h-[85vh] object-contain border-2 border-paper-raw"
        src=""
        alt=""
      />
      <div id="modalImageCaption" class="image-modal-caption text-xs sm:text-sm mt-2 sm:mt-4 px-4 text-center">
      </div>
    </div>
  </div>

  <script id="project-data" type="application/json" is:inline set:html={modalPayload} />

  <script is:inline src={scriptSrc} defer></script>
</BaseLayout>
